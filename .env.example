# Public content/order service (no Paystack secret belongs in this frontend).
CSS_API_BASE_URL=https://css-knust-api.onrender.com/api/v1/

# Optional explicit product mappings. Otherwise exact, unique approved names are used.
CSS_MERCH_TEE_ID=
CSS_MERCH_PINK_ID=

# Enable after real products, note-based surcharges, automatic discount and callbacks
# have been verified. The current backend exposes only a test merchandise record.
CSS_MERCH_PRICING_READY=false
