# Public content/order service (no Paystack secret belongs in this frontend).
CSS_API_BASE_URL=https://css-knust-api.onrender.com/api/v1/

# Legacy fallback only: products are matched by backend slug (css-tee, general-lacoste,
# bundle-mono, ...). These numeric IDs are used only while a record has no slug yet.
CSS_MERCH_TEE_ID=2
CSS_MERCH_PINK_ID=3

# Approved website origin. No Paystack keys are needed in this frontend.
NEXT_PUBLIC_SITE_ORIGIN=https://thecssknust.com
